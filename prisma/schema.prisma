generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
} 
enum AccountStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
  BANNED
}
enum PostVisibility {
  PUBLIC
  FOLLOWERS
  FRIENDS
  CIRCLE
  PRIVATE
}
enum MediaType {
  VIDEO
  IMAGE
}
enum ReactionType {
  LIKE
}
enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}
enum ReportReason {
  HARASSMENT
  HATE
  VIOLENCE
  SEXUAL_CONTENT
  SELF_HARM
  CHILD_SAFETY
  SPAM_SCAM
  IMPERSONATION
  PRIVACY
  OTHER
}
enum NotificationType {
  FOLLOW
  LIKE
  COMMENT
  LIVE_STARTED
  GIFT_RECEIVED
  FOLLOWER_MILESTONE
  REPLAY_READY
  CREATOR_LEVEL
  BADGE_UNLOCKED
}
enum AccountPrivacy { PUBLIC PRIVATE }
enum ContactPrivacy { EVERYONE FOLLOWERS FRIENDS NOBODY }
enum CirclePrivacy {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}
enum CircleRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}
enum PorchStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}
enum PorchRoomType {
  VIDEO
  VOICE
}
enum LiveVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}
enum ReplayStatus {
  PENDING
  READY
  FAILED
  DELETED
}
enum ClipVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum PorchStageRequestStatus {
  PENDING
  INVITED
  APPROVED
  DECLINED
  CANCELLED
}

enum PorchRole {
  HOST
  COHOST
  MODERATOR
  SPEAKER
  LISTENER
}

enum HostApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

enum CreatorStatus {
  ELIGIBLE
  ACTIVE
  PAUSED
  REMOVED
}

enum LedgerStatus {
  PENDING
  SETTLED
  REFUNDED
  CHARGEBACK
  ADJUSTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}
enum StaffRole {
  OWNER
  CO_OWNER
  EXECUTIVE_ADMIN
  TRUST_SAFETY
  MODERATOR
  SUPPORT
  FINANCE
  CREATOR_RELATIONS
  ENGINEERING
  ANALYTICS
}
enum ModerationAction {
  WARN
  RESTRICT
  SUSPEND
  BAN
  RESTORE
  REMOVE_CONTENT
  NO_VIOLATION
  ESCALATE
}

model User {
  id String @id @default(cuid())
  email String @unique
  username String @unique
  displayName String
  passwordHash String
  bio String?
  avatarUrl String?
  profileVideoUrl String?
  verified Boolean @default(false)
  privacy AccountPrivacy @default(PUBLIC)
  messagePrivacy ContactPrivacy @default(EVERYONE)
  commentPrivacy ContactPrivacy @default(EVERYONE)
  mentionPrivacy ContactPrivacy @default(EVERYONE)
  liveInvitePrivacy ContactPrivacy @default(EVERYONE)
  hideActivity Boolean @default(false)
  hideConnections Boolean @default(false)
  status AccountStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts Post[]
  comments Comment[]
  reactions Reaction[]
  saves Save[]
  stories Story[]
  sessions Session[]
  blocksMade Block[] @relation("blocksMade")
  blocksReceived Block[] @relation("blocksReceived")
  mutesMade Mute[] @relation("mutesMade")
  mutesReceived Mute[] @relation("mutesReceived")
  reports Report[] @relation("reportsFiled")
  notifications Notification[] @relation("notificationRecipient")
  notificationsSent Notification[] @relation("notificationActor")
  conversationMembers ConversationMember[]
  sentMessages Message[] @relation("messageSender")
  circleMemberships CircleMember[]
  porchMemberships PorchMember[]
  porchRestrictions PorchRoomRestriction[]
  hostApplication HostApplication?
  creatorProfile CreatorProfile?
  viewingProgress ViewingProgress?
  viewingSessions ViewingSession[]
  liveViewerPresences LiveViewerPresence[]
  stageRequests PorchStageRequest[]
  liveSignalsSent LiveSignal[] @relation("signalSender")
  liveSignalsReceived LiveSignal[] @relation("signalTarget")
  coinWallet CoinWallet?
  sentGiftTransactions GiftTransaction[] @relation("giftSender")
  receivedGiftTransactions GiftTransaction[] @relation("giftRecipient")
  creatorPayouts CreatorPayout[]
  payoutLedgerEntries PayoutLedgerEntry[]
  receipts Receipt[]
  badges UserBadge[]
  liveMessages LiveMessage[]
  liveReactions LiveReaction[]
  liveReplays LiveReplay[]
  clips Clip[]
  cosmetics HostCosmetic[]
  cosmeticGiftsSent CosmeticGift[] @relation("cosmeticGiftSender")
  cosmeticGiftsReceived CosmeticGift[] @relation("cosmeticGiftHost")
  staffProfile StaffProfile?
  moderationActions ModerationActionLog[] @relation("moderationActor")
  auditEvents AuditLog[] @relation("auditActor")
  followers Follow[] @relation("following")
  following Follow[] @relation("followers")
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker User @relation("blocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Mute {
  muterId String
  mutedId String
  createdAt DateTime @default(now())
  muter User @relation("mutesMade", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("mutesReceived", fields: [mutedId], references: [id], onDelete: Cascade)
  @@id([muterId, mutedId])
  @@index([mutedId])
}

model Report {
  id String @id @default(cuid())
  reporterId String
  reportedUserId String?
  postId String?
  reason ReportReason
  details String?
  status ReportStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reporter User @relation("reportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
  @@index([reportedUserId])
  @@index([postId])
}

model Follow {
  followerId String
  followingId String
  createdAt DateTime @default(now())
  follower User @relation("followers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  @@id([followerId, followingId])
  @@index([followingId])
}

model Post {
  id String @id @default(cuid())
  authorId String
  caption String?
  visibility PostVisibility @default(PUBLIC)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media Media[]
  comments Comment[]
  reactions Reaction[]
  saves Save[]
  receipts Receipt[]
  @@index([authorId, createdAt])
  @@index([createdAt])
}

model Media {
  id String @id @default(cuid())
  postId String
  type MediaType
  url String
  posterUrl String?
  width Int?
  height Int?
  durationMs Int?
  position Int @default(0)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([postId, position])
}

model Comment {
  id String @id @default(cuid())
  postId String
  authorId String
  body String
  createdAt DateTime @default(now())
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  @@index([postId, createdAt])
}

model Reaction {
  userId String
  postId String
  type ReactionType @default(LIKE)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([userId, postId])
  @@index([postId])
}

model Save {
  userId String
  postId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([userId, postId])
}

model Story {
  id String @id @default(cuid())
  authorId String
  mediaUrl String?
  text String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  @@index([authorId, createdAt])
  @@index([expiresAt])
}


model Notification {
  id String @id @default(cuid())
  recipientId String
  actorId String
  type NotificationType
  postId String?
  readAt DateTime?
  createdAt DateTime @default(now())
  recipient User @relation("notificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor User @relation("notificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}


model Conversation {
  id String @id @default(cuid())
  directKey String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members ConversationMember[]
  messages Message[]
}

model ConversationMember {
  conversationId String
  userId String
  joinedAt DateTime @default(now())
  lastReadAt DateTime?
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id String @id @default(cuid())
  conversationId String
  senderId String
  body String
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation("messageSender", fields: [senderId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}


model Circle {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String?
  privacy CirclePrivacy @default(PUBLIC)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members CircleMember[]
}

model CircleMember {
  circleId String
  userId String
  role CircleRole @default(MEMBER)
  joinedAt DateTime @default(now())
  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([circleId, userId])
  @@index([userId])
}


model PorchRoom {
  id String @id @default(cuid())
  slug String @unique
  title String
  description String?
  status PorchStatus @default(SCHEDULED)
  scheduledFor DateTime?
  roomType PorchRoomType @default(VIDEO)
  stageSize Int @default(1)
  screenSharing Boolean @default(false)
  category String?
  visibility LiveVisibility @default(PUBLIC)
  guestRequestsEnabled Boolean @default(true)
  giftsEnabled Boolean @default(true)
  chatEnabled Boolean @default(true)
  followersOnlyChat Boolean @default(false)
  slowModeSeconds Int @default(0)
  coverImageUrl String?
  defaultEffect String?
  defaultBackdrop String?
  replayVisible Boolean @default(true)
  replayUrl String?
  peakViewers Int @default(0)
  totalViewers Int @default(0)
  reactionCount Int @default(0)
  followerBaseline Int @default(0)
  startedAt DateTime?
  endedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members PorchMember[]
  roomRestrictions PorchRoomRestriction[]
  giftTransactions GiftTransaction[]
  viewingSessions ViewingSession[]
  liveViewerPresences LiveViewerPresence[]
  stageRequests PorchStageRequest[]
  liveSignals LiveSignal[]
  liveMessages LiveMessage[]
  liveReactions LiveReaction[]
  replay LiveReplay?
  clips Clip[]
  @@index([status, scheduledFor])
}

model PorchMember {
  roomId String
  userId String
  role PorchRole @default(LISTENER)
  joinedAt DateTime @default(now())
  room PorchRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([roomId, userId])
  @@index([userId])
}


model LiveMessage {
  id String @id @default(cuid())
  roomId String
  userId String
  body String
  pinned Boolean @default(false)
  createdAt DateTime @default(now())
  room PorchRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([roomId, createdAt])
  @@index([roomId, pinned])
}

model LiveReaction {
  id String @id @default(cuid())
  roomId String
  userId String
  emoji String @default("❤️")
  createdAt DateTime @default(now())
  room PorchRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([roomId, createdAt])
  @@index([userId, createdAt])
}

model LiveReplay {
  id String @id @default(cuid())
  roomId String @unique
  hostId String
  status ReplayStatus @default(PENDING)
  visible Boolean @default(true)
  mediaUrl String?
  downloadUrl String?
  durationSeconds Int @default(0)
  totalViewers Int @default(0)
  peakViewers Int @default(0)
  verifiedWatchSeconds Int @default(0)
  followersGained Int @default(0)
  reactionCount Int @default(0)
  commentCount Int @default(0)
  giftCount Int @default(0)
  giftValueCents Int @default(0)
  creatorEarningsCents Int @default(0)
  createdAt DateTime @default(now())
  readyAt DateTime?
  room PorchRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)
  clips Clip[]
  @@index([hostId, createdAt])
  @@index([status, createdAt])
}

model Clip {
  id String @id @default(cuid())
  creatorId String
  roomId String
  replayId String?
  title String?
  mediaUrl String?
  startSeconds Int
  endSeconds Int
  visibility ClipVisibility @default(PUBLIC)
  createdAt DateTime @default(now())
  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  room PorchRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  replay LiveReplay? @relation(fields: [replayId], references: [id], onDelete: SetNull)
  @@index([creatorId, createdAt])
  @@index([roomId, createdAt])
}

model LiveSignal {
  id String @id @default(cuid())
  roomId String
  senderId String
  targetUserId String?
  type String
  payloadJson String
  createdAt DateTime @default(now())
  room PorchRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User @relation("signalSender", fields: [senderId], references: [id], onDelete: Cascade)
  target User? @relation("signalTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  @@index([roomId, createdAt])
  @@index([targetUserId, createdAt])
}

model PorchStageRequest {
  id String @id @default(cuid())
  roomId String
  userId String
  status PorchStageRequestStatus @default(PENDING)
  requestedAt DateTime @default(now())
  reviewedAt DateTime?
  room PorchRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([roomId, userId])
  @@index([roomId, status, requestedAt])
}

model PorchRoomRestriction {
  roomId String
  userId String
  muted Boolean @default(false)
  banned Boolean @default(false)
  updatedAt DateTime @updatedAt
  room PorchRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([roomId, userId])
  @@index([userId])
}

model HostApplication {
  id String @id @default(cuid())
  userId String @unique
  status HostApplicationStatus @default(PENDING)
  appliedAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedById String?
  agreementAcceptedAt DateTime?
  identityVerificationStatus String @default("NOT_STARTED")
  identityProviderRef String?
  identityVerifiedAt DateTime?
  taxStatus String @default("NOT_STARTED")
  taxProviderRef String?
  taxCompletedAt DateTime?
  payoutEnabled Boolean @default(false)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([status, appliedAt])
}

model LiveViewerPresence {
  roomId String
  userId String
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  active Boolean @default(true)
  room PorchRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([roomId, userId])
  @@index([roomId, active, lastSeenAt])
}

model ViewingSession {
  id String @id @default(cuid())
  userId String
  roomId String
  startedAt DateTime @default(now())
  lastHeartbeatAt DateTime @default(now())
  endedAt DateTime?
  verifiedSeconds Int @default(0)
  eligible Boolean @default(true)
  invalidReason String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room PorchRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  @@index([userId, startedAt])
  @@index([roomId, startedAt])
}

model ViewingProgress {
  userId String @id
  verifiedSeconds BigInt @default(0)
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreatorProfile {
  userId String @id
  status CreatorStatus @default(ELIGIBLE)
  activatedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CoinWallet {
  userId String @id
  balanceCoins BigInt @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GiftTransaction {
  id String @id @default(cuid())
  senderId String
  recipientId String
  roomId String?
  giftKey String
  giftName String
  coinCost BigInt
  dollarValueCents Int
  creatorShareCents Int
  platformShareCents Int
  paymentFeeCents Int @default(0)
  appStoreFeeCents Int @default(0)
  taxCents Int @default(0)
  adjustmentCents Int @default(0)
  status LedgerStatus @default(PENDING)
  refundStatus String?
  createdAt DateTime @default(now())
  settledAt DateTime?
  sender User @relation("giftSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient User @relation("giftRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  room PorchRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  @@index([senderId, createdAt])
  @@index([recipientId, createdAt])
  @@index([status, createdAt])
}

model HostCosmetic {
  userId String
  effectKey String
  unlockedAt DateTime @default(now())
  source String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, effectKey])
}

model CosmeticGift {
  id String @id @default(cuid())
  senderId String
  hostId String
  effectKey String
  coinCost BigInt
  createdAt DateTime @default(now())
  sender User @relation("cosmeticGiftSender", fields: [senderId], references: [id], onDelete: Restrict)
  host User @relation("cosmeticGiftHost", fields: [hostId], references: [id], onDelete: Restrict)
  @@index([hostId, createdAt])
}

model CreatorPayout {
  id String @id @default(cuid())
  creatorId String
  amountCents Int
  status PayoutStatus @default(PENDING)
  providerTransactionId String?
  scheduledFor DateTime?
  paidAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  creator User @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  @@index([creatorId, createdAt])
  ledgerEntries PayoutLedgerEntry[]
  @@index([status, scheduledFor])
}

model PayoutLedgerEntry {
  id String @id @default(cuid())
  creatorId String
  payoutId String?
  kind String
  amountCents Int
  referenceType String?
  referenceId String?
  note String?
  createdAt DateTime @default(now())
  creator User @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  payout CreatorPayout? @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  @@index([creatorId, createdAt])
  @@index([payoutId])
  @@index([referenceType, referenceId])
}

model Receipt {
  id String @id @default(cuid())
  postId String
  authorId String
  title String
  sourceUrl String?
  note String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  @@index([postId, createdAt])
  @@index([authorId, createdAt])
}


model UserBadge {
  id String @id @default(cuid())
  userId String
  key String
  name String
  icon String?
  unlockedAt DateTime @default(now())
  featured Boolean @default(false)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, key])
  @@index([userId, unlockedAt])
}

model StaffProfile {
  userId String @id
  role StaffRole
  active Boolean @default(true)
  mfaRequired Boolean @default(true)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ModerationActionLog {
  id String @id @default(cuid())
  actorId String
  targetUserId String?
  targetPostId String?
  action ModerationAction
  reason String
  caseRef String?
  createdAt DateTime @default(now())
  actor User @relation("moderationActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([targetUserId, createdAt])
  @@index([targetPostId, createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  resourceType String
  resourceId String?
  reason String
  metadataJson String?
  createdAt DateTime @default(now())
  actor User @relation("auditActor", fields: [actorId], references: [id], onDelete: Restrict)
  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
}

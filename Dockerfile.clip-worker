FROM node:22-bookworm-slim
WORKDIR /worker

RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 1001 outside \
 && useradd --system --uid 1001 --gid outside worker

COPY --chown=worker:outside scripts/clip-worker.mjs ./clip-worker.mjs

USER worker

ENV NODE_ENV=production
ENV CLIP_WORKER_POLL_MS=3000

CMD ["node","clip-worker.mjs"]

# Add real secrets only in your deployment environment. Never commit them.
# For Supabase/pooled production traffic, DATABASE_URL should use the runtime/pooler connection.
DATABASE_URL=
# Prisma migrations require a direct PostgreSQL connection. Do not point this at a transaction pooler.
DIRECT_URL=

# Authentication/security.
# Use a long random secret. Rotating it changes request-security hashes.
AUTH_SECRET=
# 32 random bytes as base64, or 64 hex characters. Used only to encrypt MFA secrets at rest.
MFA_ENCRYPTION_KEY=

# Transactional email. Production should use "resend".
EMAIL_DELIVERY_MODE=resend
RESEND_API_KEY=
# Example: OUTSiiDE <security@yourdomain.com>
EMAIL_FROM=

# Production: https://outsiide.net
# Local development may override this with http://localhost:3000
NEXT_PUBLIC_APP_URL=https://outsiide.net

# Media storage.
# Production uses a PRIVATE S3-compatible bucket (Cloudflare R2, AWS S3, etc.).
MEDIA_STORAGE_MODE=s3
# Keep this stable after launch: stored media delivery URLs are signed with it.
MEDIA_SIGNING_SECRET=
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=auto
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# Optional for temporary S3 credentials.
MEDIA_S3_SESSION_TOKEN=

# Production Live transport.
# Production launch requires LiveKit/SFU mode. Mesh is development fallback only.
LIVE_MEDIA_PROVIDER=livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Live replay recording through LiveKit Egress into the private media bucket.
LIVE_RECORDING_MODE=livekit
# CI only; never enable in production.
LIVEKIT_TEST_MODE=false
LIVE_RECORDING_TEST_MODE=false

# Payments and creator payouts.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# CI only; never enable in production.
STRIPE_TEST_MODE=false

# Scale infrastructure. Required in production for distributed rate limits and hot-path state.
REDIS_URL=
MEDIA_TRANSCODING_SERVICE_URL=


# Runtime readiness.
# Leave READINESS_MODE unset in production so checks are strict.
# CI sets READINESS_MODE=test explicitly.
READINESS_MODE=


# Background clip processing.
# Use a separate long random secret shared only by the web app and clip worker.
CLIP_WORKER_SECRET=
# Worker container only:
CLIP_WORKER_BASE_URL=
CLIP_WORKER_POLL_MS=3000


# Scheduled battle ranking / jackpot / season rollups.
# Use a separate long random secret shared only with the scheduler.
BATTLE_CRON_SECRET=
